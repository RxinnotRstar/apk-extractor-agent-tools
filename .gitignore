# ---- 构建产物 ----
build/
preview/
*.apk
*.idsig
*.ap_

# ---- 签名材料（泄露 = 任何人可伪造同包名更新）----
*.keystore
*.jks
*.p12
*.pepk

# ---- 编译中间件 ----
*.class
*.dex
*.jar

# ---- 编辑器 / IDE ----
.idea/
*.iml
.vscode/
*.swp
*~

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时文件 ----
*.log
*.tmp
*.bak

# ---- 上传到 GitHub 用的载荷包（网页上传路线，不该入库）----
payload.zip

# ---- Python ----
__pycache__/
*.pyc

# ---- 上传时的一次性删除清单（临时指令，不该入库）----
.unpack-delete
